# Dependencies
node_modules/
.pnp/
.pnp.js

# Environment / secrets — never commit real values, only .env.example / .env.test.example
.env
.env.*
!.env.example
!.env.test.example

# Build outputs
dist/
build/
.next/
out/
*.tsbuildinfo

# Test / coverage
coverage/
.nyc_output/

# Logs
*.log
npm-debug.log*
logs/

# Uploads / local file storage (LocalDiskStorage dev fallback, default STORAGE_LOCAL_DIR, resolved
# relative to apps/api's own cwd — never committed). Anchored to that exact runtime path, not a
# bare `uploads/`: a bare pattern matches ANY directory named "uploads" anywhere in the repo,
# including the real source module apps/api/src/uploads/ (UploadsModule/UploadsController/
# UploadsService, added for the admin product-image-upload feature) — the exact same class of bug
# already found once for a bare `storage/` pattern hiding apps/api/src/storage/ (see git history),
# caught here before it repeated.
apps/api/uploads/
public/uploads/

# Local databases / dumps
*.sqlite
*.sqlite3
*.db
*.dump
apps/api/prisma/migrations/dev.db

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Claude Code local (per-machine permissions, not shared project config)
.claude/settings.local.json

# Misc
*.pid
*.seed
*.pid.lock
