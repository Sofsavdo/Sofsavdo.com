# Dependencies
node_modules/
.pnp/
.pnp.js

# Environment / secrets — never commit real values, only .env.example / .env.test.example
.env
.env.*
!.env.example
!.env.test.example

# Build outputs
dist/
build/
.next/
out/
*.tsbuildinfo

# Test / coverage
coverage/
.nyc_output/

# Logs
*.log
npm-debug.log*
logs/

# Uploads / local file storage (LocalDiskStorage dev fallback, default STORAGE_LOCAL_DIR — never
# committed). Deliberately NOT a bare `storage/` pattern: that also matched the real source
# directory apps/api/src/storage/ (StorageModule/StoragePort/adapters) and silently kept it out of
# every commit since it was introduced — a fresh clone (e.g. a Railway build) failed with
# "Cannot find module './storage/storage.module'" until this was caught and fixed.
uploads/
public/uploads/

# Local databases / dumps
*.sqlite
*.sqlite3
*.db
*.dump
apps/api/prisma/migrations/dev.db

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Claude Code local (per-machine permissions, not shared project config)
.claude/settings.local.json

# Misc
*.pid
*.seed
*.pid.lock
