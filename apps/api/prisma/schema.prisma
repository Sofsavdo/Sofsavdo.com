// Sofsavdo — Creator Affiliate Commerce Platform
// Prisma schema — Phase 1 architecture artifact.
// Convention: every monetary field is an Int in minor currency units (tiyin/kopeck
// equivalent for so'm — 1 so'm = 100 minor units) — never Float/Decimal-as-float.

generator client {
  provider = "prisma-client-js"
}

// Connection URL lives in prisma.config.ts (Prisma 7 driver-adapter model), not here.
datasource db {
  provider = "postgresql"
}

// ────────────────────────────────────────────────────────────────────────────
// Auth / RBAC
// ────────────────────────────────────────────────────────────────────────────

// BLOCKED added (Phase 12, Admin Operations) — a more severe, SUPER_ADMIN-only creator-account
// action distinct from SUSPENDED (ADMIN-gated, reversible pause). Both are additive to a frozen
// enum with zero behavior change to existing ACTIVE/SUSPENDED/DELETED handling. See DECISIONS.md
// ADR-019.
enum UserStatus {
  ACTIVE
  SUSPENDED
  BLOCKED
  DELETED
}

model User {
  id               String     @id @default(cuid())
  email            String?    @unique
  phone            String?    @unique
  passwordHash     String
  // Nullable — every account before Phase 12 was created without one (staff via seed, creators
  // via CreatorProfile.displayName instead). Populated going forward for staff created through the
  // real admin User Management UI; the frontend's pre-existing email-local-part fallback (see
  // admin-real.ts's mapSessionUserToAdminUser) stays in place for rows where this is still null.
  displayName      String?
  status           UserStatus @default(ACTIVE)
  emailVerified    DateTime?
  phoneVerified    DateTime?
  lastLoginAt      DateTime?
  // Phase 10 — set once the user links their Telegram account (e.g. via a /start deep-link token
  // exchanged for this chat id); null means Telegram delivery is impossible regardless of the
  // user's own preference toggle, same as an unconfigured PayoutMethod blocking a payout request.
  telegramChatId   String?    @unique
  // Per-account brute-force lockout (Phase A, production-hardening pass) — a sibling mitigation to
  // the per-IP ThrottlerGuard limits already on /auth/login. failedLoginCount resets to 0 on any
  // successful login; lockedUntil is set once the count crosses configuration.ts's
  // auth.maxFailedLoginAttempts and read (not re-derived from the count) on every login attempt,
  // so a lockout's expiry is a fixed point in time rather than something a slow trickle of retries
  // could keep pushing back.
  failedLoginCount Int        @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  roles                        UserRole[]
  creatorProfile               CreatorProfile?
  refreshTokens                RefreshToken[]
  auditLogsActed               AuditLog[]               @relation("AuditActor")
  notifications                Notification[]
  notificationPreferences      NotificationPreference[]
  offersCreated                Offer[]                  @relation("OfferCreatedBy")
  offersUpdated                Offer[]                  @relation("OfferUpdatedBy")
  landingPagesCreated          LandingPage[]            @relation("LandingCreatedBy")
  landingPagesUpdated          LandingPage[]            @relation("LandingUpdatedBy")
  campaignsCreated             Campaign[]               @relation("CampaignCreatedBy")
  campaignsUpdated             Campaign[]               @relation("CampaignUpdatedBy")
  campaignApplicationsReviewed CampaignApplication[]    @relation("CampaignApplicationReviewedBy")
  contentReviewed              Content[]                @relation("ContentReviewedBy")
  contentVersionsSubmitted     ContentVersion[]         @relation("ContentVersionSubmittedBy")
  contentReviewComments        ContentReviewComment[]   @relation("ContentReviewCommentAuthor")
  customer                     Customer?
  savedProducts                SavedProduct[]
  buyerAddresses               BuyerAddress[]
  competitionsCreated          Competition[]            @relation("CompetitionCreatedBy")
  competitionsUpdated          Competition[]            @relation("CompetitionUpdatedBy")

  @@index([status])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Role {
  id          String  @id @default(cuid())
  key         String  @unique // e.g. "super_admin", "admin", "manager", "creator"
  name        String
  description String?

  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id    String @id @default(cuid())
  key   String @unique // e.g. "orders.write", "payouts.approve"
  label String

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

// ────────────────────────────────────────────────────────────────────────────
// Creator
// ────────────────────────────────────────────────────────────────────────────

// CHANGES_REQUESTED (renamed from REVISION_REQUESTED — Phase 11) matches the identical state name
// already used by CampaignApplicationStatus/ContentStatus, so one vocabulary describes "admin sent
// this back for edits" everywhere in the codebase. Zero real rows existed with this status before
// Phase 11 built the first real service to ever write it, so this is a rename, not a breaking
// change — same precedent as ADR-011/012/015/016. See DECISIONS.md ADR-018.
enum CreatorApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  CHANGES_REQUESTED
  APPROVED
  REJECTED
}

// Phase Q — see CreatorProfile.bioComplianceStatus's own comment and DECISIONS.md ADR-034.
enum BioComplianceStatus {
  PENDING
  COMPLIANT
  NON_COMPLIANT
}

enum CreatorTier {
  STANDARD
  PREMIUM
}

model CreatorProfile {
  id                  String              @id @default(cuid())
  userId              String              @unique
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName         String
  city                String?
  bio                 String?
  contentNiches       String[] // e.g. ["beauty", "edtech"]
  avatarFileId        String?
  // Stable creator-to-creator referral code (6B Enhancement) — generated at registration,
  // backfilled for pre-existing creators by the migration, never rotated (no rotation
  // requirement exists; a stable code keeps already-shared links working forever).
  referralCode        String              @unique
  // Phase Q — whether an admin has manually spot-checked that this creator's public social bio
  // mentions sofsavdo.com, per the platform's contractual requirement. PENDING (never checked) is
  // the honest default — never auto-assumed COMPLIANT, since no automated bio-scraping exists (see
  // DECISIONS.md ADR-034). Enforcement (PayoutsService.requestPayout) only ever blocks on
  // NON_COMPLIANT, never on PENDING — an unreviewed creator isn't penalized for an admin backlog.
  bioComplianceStatus BioComplianceStatus @default(PENDING)
  // The Premium exemption: a NON_COMPLIANT + PREMIUM creator is still allowed to request payouts —
  // see Decision in ADR-034 on why this is an incentive, not a bypass.
  tier                CreatorTier         @default(STANDARD)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  socialAccounts       SocialAccount[]
  applications         CreatorApplication[]
  campaigns            CreatorCampaign[]
  campaignApplications CampaignApplication[]
  referralLinks        ReferralLink[]
  promoCodes           PromoCode[]
  commissions          Commission[]
  payoutMethods        PayoutMethod[]
  payouts              Payout[]
  referralsGiven       CreatorReferral[]         @relation("ReferralReferrer")
  referralReceived     CreatorReferral?          @relation("ReferralReferred")
  contents             Content[]                 @relation("ContentByCreator")
  fundContributions    CreatorFundContribution[]
  competitionParticipants CompetitionParticipant[]

  @@index([city])
}

enum SocialPlatform {
  INSTAGRAM
  TIKTOK
  YOUTUBE
  TELEGRAM
}

model SocialAccount {
  id            String         @id @default(cuid())
  creatorId     String
  creator       CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  platform      SocialPlatform
  handle        String
  profileUrl    String
  followerCount Int            @default(0)
  createdAt     DateTime       @default(now())

  @@index([creatorId])
}

model CreatorApplication {
  id           String                   @id @default(cuid())
  creatorId    String
  creator      CreatorProfile           @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  status       CreatorApplicationStatus @default(DRAFT)
  currentStep  Int                      @default(1)
  formData     Json // audience info, experience, payout details, etc.
  reviewNote   String?
  reviewedById String?
  reviewedAt   DateTime?
  submittedAt  DateTime?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@index([creatorId])
  @@index([status])
}

// ────────────────────────────────────────────────────────────────────────────
// Product / Offer / Landing
// ────────────────────────────────────────────────────────────────────────────

enum ProductType {
  PHYSICAL_PRODUCT
  DIGITAL_PRODUCT
  COURSE
  SERVICE
  CONSULTATION
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Product {
  id               String        @id @default(cuid())
  name             String
  slug             String        @unique
  type             ProductType
  shortDescription String?
  description      String?
  brand            String?
  sku              String?       @unique
  status           ProductStatus @default(DRAFT)
  images           String[]
  videos           String[]
  attributes       Json?
  costPriceMinor   Int?
  currency         String        @default("UZS")
  internalNotes    String?
  // Physical-inventory tracking (Phase 8). null = untracked (digital/course/service products, or a
  // physical product whose stock isn't managed yet) — checkout skips the stock check entirely in
  // that case. A non-null value is decremented atomically when an Order reaches PAID (see
  // OrdersService.reserveStock) and restored on REFUNDED/CANCELLED-after-paid. The
  // Product_stock_non_negative_check DB constraint (raw SQL, this migration) is the real
  // concurrency guard — two simultaneous PAID transitions racing past the app-level check can't
  // both succeed, since Postgres will reject whichever commit second. A dedicated
  // Inventory/warehouse model can layer on top of this field later without breaking it.
  stockQuantity    Int?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  offers Offer[]

  @@index([type, status])
}

enum OfferType {
  ONE_TIME
  INSTALLMENT
  SUBSCRIPTION
  APPLICATION_BASED
}

enum OfferCtaType {
  BUY_NOW
  ORDER_FORM
  APPLY_NOW
  BOOK_CALL
  PAY_INSTALLMENT
}

// Deliberately no EXPIRED here — expiry is a COMPUTED availability state derived from
// startsAt/expiresAt vs. now, never a stored value. Storing it would let a status field and the
// wall clock disagree (an offer manually left at status=ACTIVE past its expiresAt would still
// read "ACTIVE" from the database while genuinely unavailable to buyers) — see OffersService's
// `computeAvailability()` for the derivation and PROJECT_STATUS.md's Phase 6B Offer section for
// the reasoning. `archivedAt` (below) is the separate, explicit archive-state signal; `status`
// is the separate, explicit lifecycle signal an admin actually set.
enum OfferStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

model Offer {
  id                  String       @id @default(cuid())
  productId           String
  product             Product      @relation(fields: [productId], references: [id])
  name                String
  slug                String       @unique
  offerType           OfferType    @default(ONE_TIME)
  headline            String
  subheadline         String?
  // Admin-only context about the offer's commercial setup — distinct from headline/subheadline,
  // which are buyer-facing landing-page copy.
  internalDescription String?
  priceMinor          Int
  compareAtPriceMinor Int?
  currency            String       @default("UZS")
  bonuses             Json?
  deliveryInfo        Json?
  paymentOptions      String[] // e.g. ["CLICK","PAYME","CARD","COD"]
  installmentOptions  Json?
  ctaType             OfferCtaType @default(BUY_NOW)
  ctaLabel            String?
  startsAt            DateTime?
  expiresAt           DateTime?
  status              OfferStatus  @default(DRAFT)
  // Set only by the archive transition, cleared never (archiving is one-way — see
  // OffersService's transition matrix). Separate from `status` so "when was this archived" is
  // queryable/sortable without parsing AuditLog, and so a future "unarchive" decision (if the
  // business ever wants one) has a real timestamp to reason about instead of just an enum flip.
  archivedAt          DateTime?
  seoTitle            String?
  seoDescription      String?
  isIndexable         Boolean      @default(false)
  // Editorial curation flag for the public homepage's featured-products section (Phase C/Sofsavdo
  // pivot) — deliberately independent of `status`/`computeAvailability()`: an admin can pre-feature
  // an offer before it goes ACTIVE, and the public read side (OffersService.listFeaturedPublic)
  // is what actually enforces "must also be live right now", the same separation of concerns as
  // the stored-status-vs-computed-availability split documented on OfferStatus above.
  isFeatured          Boolean      @default(false)
  createdById         String?
  createdBy           User?        @relation("OfferCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById         String?
  updatedBy           User?        @relation("OfferUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  variants        OfferVariant[]
  landingPage     LandingPage?
  campaigns       Campaign[]
  referralLinks   ReferralLink[]
  promoCodes      PromoCode[]
  orders          Order[]
  referralVisits  ReferralVisit[]
  deliveryRegions OfferDeliveryRegion[]
  savedByUsers    SavedProduct[]

  @@index([status])
  @@index([productId])
  @@index([archivedAt])
  @@index([startsAt, expiresAt])
  @@index([isFeatured, status])
}

model OfferVariant {
  id         String  @id @default(cuid())
  offerId    String
  offer      Offer   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  name       String // "1 dona", "Premium tarif", etc.
  priceMinor Int
  sortOrder  Int     @default(0)
  isDefault  Boolean @default(false)
  metadata   Json?

  orderItems OrderItem[]

  @@index([offerId])
}

enum DeliveryFeeType {
  FREE
  FIXED
}

enum DeliveryAvailability {
  AVAILABLE
  UNAVAILABLE
}

// Regional delivery pricing (6B Enhancement). Owned by Offer, not Product — different Offers for
// the same Product may run different delivery promotions (spec-confirmed ownership). Only Offers
// whose Product.type is PHYSICAL_PRODUCT may have rows here (service-enforced; a DB-level
// cross-table check isn't practical in Postgres without triggers). FREE rows must have
// deliveryFeeMinor = 0 and FIXED rows a positive fee — enforced by the
// OfferDeliveryRegion_fee_check DB constraint plus estimatedMinDays <= estimatedMaxDays by
// OfferDeliveryRegion_days_check (raw SQL in the 6B Enhancement migration).
model OfferDeliveryRegion {
  id               String               @id @default(cuid())
  offerId          String
  offer            Offer                @relation(fields: [offerId], references: [id], onDelete: Cascade)
  countryCode      String               @default("UZ")
  regionCode       String
  regionName       String
  availability     DeliveryAvailability @default(AVAILABLE)
  feeType          DeliveryFeeType
  deliveryFeeMinor Int                  @default(0)
  currency         String               @default("UZS")
  estimatedMinDays Int?
  estimatedMaxDays Int?
  active           Boolean              @default(true)
  sortOrder        Int                  @default(0)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@unique([offerId, regionCode])
  @@index([offerId, sortOrder])
}

// A Landing has no slug of its own — it is addressed via its Offer's already-unique `slug`
// (1:1 relation, public route is `/offers/:slug/public` per API.md), so a second unique slug
// here would just be a second name for the same address with no way to keep them in sync.
enum LandingStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model LandingPage {
  id       String @id @default(cuid())
  offerId  String @unique
  offer    Offer  @relation(fields: [offerId], references: [id], onDelete: Cascade)
  template String @default("default")

  status      LandingStatus @default(DRAFT)
  // Set on the DRAFT/PUBLISHED->PUBLISHED transition, never cleared — an "already published
  // once" fact, distinct from `status` which can move back to DRAFT (unpublish).
  publishedAt DateTime?
  // Set only by the archive transition, cleared never — same one-way pattern as Offer.archivedAt.
  archivedAt  DateTime?

  // Buyer-facing SEO metadata for the public landing page — distinct from Offer.seoTitle/
  // seoDescription (which predate this slice and are not used by the public route below);
  // kept here since SEO is a property of the rendered page, not the commercial config.
  seoTitle       String?
  seoDescription String?
  seoKeywords    String[]
  ogImageUrl     String?

  createdById String?
  createdBy   User?   @relation("LandingCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   User?   @relation("LandingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sections LandingSection[]

  @@index([status])
  @@index([archivedAt])
}

enum LandingSectionType {
  HERO
  PROBLEM
  SOLUTION
  BENEFITS
  HOW_IT_WORKS
  AUDIENCE
  NOT_FOR
  CREATOR_VIDEO
  PRODUCT_GALLERY
  PRICING
  OFFER_VARIANTS
  BONUSES
  REVIEWS
  GUARANTEE
  TERMS
  DELIVERY
  PAYMENT
  FAQ
  FINAL_CTA
  CUSTOM_RICH_TEXT
}

model LandingSection {
  id            String             @id @default(cuid())
  landingPageId String
  landingPage   LandingPage        @relation(fields: [landingPageId], references: [id], onDelete: Cascade)
  type          LandingSectionType
  sortOrder     Int                @default(0)
  isActive      Boolean            @default(true)
  content       Json // text, image/video refs, CTA label, background/layout variant

  @@index([landingPageId, sortOrder])
}

// Homepage CMS (Sofsavdo architecture review, Part 1 §2) — deliberately a flat top-level table,
// not scoped to a parent the way LandingSection is scoped to LandingPage: the homepage has no
// natural 1:1 parent entity, and (unlike an Offer's landing page) there is no draft/published/
// archived workflow here — the homepage is always live, and each section's own isActive flag is
// the only visibility switch, edited directly (see DECISIONS.md ADR-027). FEATURED_PRODUCTS is a
// deliberate exception: its content is never read for copy — the section's presence+isActive only
// tells the homepage whether to render the existing OffersService.listFeaturedPublic() slot, so
// "trending"/"curated" stays a single source of truth in Offer.isFeatured, not duplicated here.
// CATEGORY_GRID ships as a type now so the enum is future-complete, but stays unused/unbuildable
// until Phase E's own Category model exists (see ADR-027) — do not build category data twice.
enum HomepageSectionType {
  HERO
  WHY_SOFSAVDO
  FEATURED_PRODUCTS
  BANNER
  CREATOR_PROGRAM_BLURB
  BENEFITS
  FAQ
  SUPPORT
  CUSTOM_RICH_TEXT
  CATEGORY_GRID
}

model HomepageSection {
  id        String              @id @default(cuid())
  type      HomepageSectionType
  sortOrder Int                 @default(0)
  isActive  Boolean             @default(true)
  content   Json
  // Scheduling window for seasonal banners/campaigns — reuses the same stored-flag-plus-computed-
  // availability split Offer.startsAt/expiresAt already established (see OffersService.
  // computeAvailability); a banner with a date window just IS a section whose computed
  // availability lapses, not a separate "SeasonalCampaign" entity.
  startsAt  DateTime?
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

// ────────────────────────────────────────────────────────────────────────────
// Campaign
// ────────────────────────────────────────────────────────────────────────────

// Narrowed from PERCENTAGE|FIXED_PER_SALE|FIXED_CONTENT_FEE|HYBRID to the two explicit
// commercial modes the 6B Enhancement spec mandates (see DECISIONS.md ADR-013). The retired
// values were mock-era drafts — the only real Campaign row was PERCENTAGE. The dual-meaning
// `commissionValue` column is replaced by the explicit commissionRateBps/commissionAmountMinor
// pair below, with a DB CHECK constraint enforcing mutual exclusivity.
enum CommissionType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

// OPEN and CANCELLED (from the Phase 1 draft schema) are retired in favor of the Phase 6B spec's
// explicit 5-state model — see DECISIONS.md ADR-011. No real Campaign rows existed yet (no backend
// slice had been built), so this is a clean rename, not a destructive change to real data.
enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

model Campaign {
  id      String @id @default(cuid())
  offerId String
  offer   Offer  @relation(fields: [offerId], references: [id])

  // `name` is the creator-facing title (rendered directly in the creator catalog today — see
  // DECISIONS.md ADR-011) — NOT renamed, to avoid breaking the existing frontend/mock contract.
  // `internalName`/`internalNotes` are additive, admin-only fields for the "internal name" /
  // "internal description" the spec asked for, distinct from the buyer-safe `name`/`description`.
  name          String
  internalName  String?
  slug          String  @unique
  description   String?
  internalNotes String?
  category      String
  ctaLabel      String

  goal           String?
  targetAudience String?

  platforms         SocialPlatform[]
  contentFormats    String[]
  requiredElements  String[] // "dos" — also the free-form home for required hashtags/mentions/links
  forbiddenElements String[] // "don'ts"
  referenceContent  String[]

  // Simple heuristic, not per-platform: checked against a creator's highest SocialAccount.followerCount
  // across all their platforms. Deliberately coarse — see DECISIONS.md ADR-011 for why nothing
  // more structured (allowed categories, per-platform eligibility rules) was added this slice.
  minFollowers Int?
  maxFollowers Int?

  requiredContentCount Int?
  contentDeadline      DateTime?

  startDate             DateTime?
  endDate               DateTime?
  applicationStartDate  DateTime?
  applicationDeadline   DateTime?
  creatorLimit          Int?
  requiresApproval      Boolean        @default(true)
  commissionType        CommissionType
  // PERCENTAGE => commissionRateBps set, commissionAmountMinor NULL.
  // FIXED_AMOUNT => commissionAmountMinor set (positive, minor units), commissionRateBps NULL.
  // Enforced by the Campaign_commission_mode_check DB constraint (raw SQL in the 6B Enhancement
  // migration — Prisma schema can't express CHECK constraints) and again in CampaignsService.
  commissionRateBps     Int?
  commissionAmountMinor Int?
  commissionCurrency    String         @default("UZS")
  customerDiscountType  DiscountType?
  // Basis points if customerDiscountType == PERCENTAGE, minor-unit amount if FIXED_AMOUNT —
  // same dual-meaning convention as commissionValue above and PromoCode.discountValue below.
  customerDiscountValue Int?
  barterEnabled         Boolean        @default(false)
  freeProduct           String?
  attributionWindowDays Int            @default(30)

  status     CampaignStatus @default(DRAFT)
  // Set only by the archive transition, cleared never — same one-way pattern as Offer/LandingPage.
  archivedAt DateTime?

  createdById String?
  createdBy   User?   @relation("CampaignCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   User?   @relation("CampaignUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  media            CampaignMedia[]
  applications     CampaignApplication[]
  creatorCampaigns CreatorCampaign[]
  referralLinks    ReferralLink[]
  promoCodes       PromoCode[]
  referralVisits   ReferralVisit[]
  orders           Order[]
  commissionRules  CommissionRule[]
  contents         Content[]

  @@index([offerId])
  @@index([status])
  @@index([archivedAt])
  @@index([startDate, endDate])
  @@index([applicationStartDate, applicationDeadline])
}

enum CampaignMediaType {
  IMAGE
  VIDEO
}

enum CampaignMediaRole {
  COVER
  GALLERY
  PROMOTIONAL
}

// Campaign visual media (6B Enhancement). Binary content lives behind the StoragePort abstraction
// (local-disk adapter in dev/test — see apps/api/src/storage/); only keys/URLs/metadata are stored
// here. At most one COVER per campaign, enforced by a partial unique index
// (CampaignMedia_cover_unique, raw SQL — Prisma can't express partial indexes).
model CampaignMedia {
  id               String            @id @default(cuid())
  campaignId       String
  campaign         Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  mediaType        CampaignMediaType
  mediaRole        CampaignMediaRole
  storageKey       String
  publicUrl        String
  thumbnailUrl     String?
  originalFilename String
  mimeType         String
  fileSizeBytes    Int
  width            Int?
  height           Int?
  durationSeconds  Int?
  sortOrder        Int               @default(0)
  altText          String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([campaignId, sortOrder])
  @@index([campaignId, mediaRole])
}

// PENDING retired in favor of this explicit lifecycle — see DECISIONS.md ADR-012. Only APPROVED
// rows existed for real (seeded directly as APPROVED), so this is a clean rename, not a
// destructive change to real data.
enum CampaignApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  WITHDRAWN
}

model CampaignApplication {
  id         String                    @id @default(cuid())
  campaignId String
  campaign   Campaign                  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creatorId  String
  creator    CreatorProfile            @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  status     CampaignApplicationStatus @default(DRAFT)

  // Creator-authored — the pitch/message plus supporting evidence for the campaign in question.
  message            String? // pitch/message — kept as the pre-existing field name, not duplicated
  platform           SocialPlatform?
  contentFormat      String?
  portfolioLinks     String[]
  sampleContentLinks String[]
  // Free-form answers to campaign-specific questions — Campaign has no structured "questions"
  // field to validate against yet, so this stays a passthrough Json bag (see DECISIONS.md ADR-012).
  answers            Json?

  // Snapshot at submission time — explicitly distinct from live CreatorProfile/SocialAccount data,
  // which can change after the fact (see schema comment convention used elsewhere for snapshots).
  followerSnapshot Int?

  // Admin-authored review outcome. Only ever holds the *latest* reason for each kind — no
  // historical trail beyond that (see DECISIONS.md ADR-012 for why no review-event history table
  // was added this slice).
  adminNotes             String?
  rejectionReason        String?
  changesRequestedReason String?

  submittedAt  DateTime?
  reviewedAt   DateTime?
  approvedAt   DateTime?
  rejectedAt   DateTime?
  withdrawnAt  DateTime?
  reviewedById String?
  reviewedBy   User?     @relation("CampaignApplicationReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contents Content[]

  @@unique([campaignId, creatorId])
  @@index([campaignId])
  @@index([creatorId])
  @@index([status])
  @@index([createdAt])
  @@index([submittedAt])
  @@index([reviewedAt])
}

// ────────────────────────────────────────────────────────────────────────────
// Creator Motivation System — Competitions (Sofsavdo architecture review, Phase L)
// ────────────────────────────────────────────────────────────────────────────

// Deliberately smaller than CampaignStatus — no PAUSED. A time-bound contest pausing mid-way (and
// resuming with what date window?) is speculative complexity this domain hasn't asked for; DRAFT
// can go straight to ARCHIVED (cancelled before ever going live) or ACTIVE (published).
enum CompetitionStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

model Competition {
  id               String            @id @default(cuid())
  name             String
  description      String?
  startAt          DateTime
  endAt            DateTime
  status           CompetitionStatus @default(DRAFT)
  // Metrika turi: buyurtma soni yoki taklif qilingan do'stlar soni
  metric           String            @default("ORDER_COUNT")
  // 3 ta o'rin sovrinlari
  firstPrize       String
  secondPrize      String
  thirdPrize       String
  // Reklama rasm URL
  imageUrl         String?
  // Set only by the archive transition, cleared never — same convention as Offer.archivedAt.
  archivedAt       DateTime?
  createdById      String?
  createdBy        User?             @relation("CompetitionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById      String?
  updatedBy        User?             @relation("CompetitionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  participants     CompetitionParticipant[]

  @@index([status])
  @@index([startAt, endAt])
}

// Competition participants - tracks when a creator joins a competition
// This allows competition-specific scoring (orders/referrals counted from join date)
model CompetitionParticipant {
  id            String   @id @default(cuid())
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  creatorId     String
  creator       CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  joinedAt      DateTime @default(now())
  createdAt     DateTime @default(now())

  @@unique([competitionId, creatorId])
  @@index([competitionId])
  @@index([creatorId])
}

// ────────────────────────────────────────────────────────────────────────────
// Content Management (Phase 7A)
// ────────────────────────────────────────────────────────────────────────────
//
// Distinct from the legacy `CreatorContent`/`CreatorContentStatus` below (mock-era stub, tied to
// `CreatorCampaign` rather than `Campaign`+`CampaignApplication`+`CreatorProfile` directly, no
// version history, no review-comment table, no CHANGES_REQUESTED/EXPIRED states, unreferenced by
// any real service) — kept untouched so nothing that still reads it breaks; the real Content
// vertical below supersedes it going forward. See DECISIONS.md ADR-014.
//
// Lifecycle: DRAFT → SUBMITTED → UNDER_REVIEW → CHANGES_REQUESTED → APPROVED | REJECTED | EXPIRED.
// REJECTED and EXPIRED are terminal (no resubmission — a rejected/expired Content cannot be
// resubmitted; the creator must create a brand-new Content). APPROVED is immutable. EXPIRED is
// lazily materialized (written the next time the row is read/mutated after the owning Campaign's
// contentDeadline has passed) rather than cron-driven — this codebase has no scheduler/queue
// infrastructure; see ContentService.expireIfPastDeadline().
enum ContentStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  EXPIRED
}

// One Content per creator submission — a Campaign's requiredContentCount can be > 1, so a single
// CampaignApplication legitimately owns many Content rows (no uniqueness constraint between them).
model Content {
  id                    String              @id @default(cuid())
  campaignId            String
  campaign              Campaign            @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creatorId             String
  creator               CreatorProfile      @relation("ContentByCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  campaignApplicationId String
  campaignApplication   CampaignApplication @relation(fields: [campaignApplicationId], references: [id], onDelete: Cascade)

  status ContentStatus @default(DRAFT)

  caption  String?
  notes    String?
  hashtags String[]
  // Free-form, creator-authored structured extras (e.g. platform-specific fields) — same
  // passthrough-Json-bag convention as CampaignApplication.answers.
  metadata Json?

  // Phase P — the live URL of the creator's actual social-media post, required (alongside at
  // least one screenshot attachment) before a submit/resubmit is accepted (see
  // ContentService.assertSubmittable). Lets an admin click through and verify the post really
  // exists, the same way Perfluence-style contractual verification works; the screenshot
  // attachment remains the permanent evidence archive independent of the link's future fate
  // (edited/deleted) — see DECISIONS.md ADR-033.
  postUrl String?

  // 0 while still an unsubmitted DRAFT; becomes 1 on first submit, +1 on every resubmit after
  // CHANGES_REQUESTED. Mirrors ContentVersion.versionNumber — the count of permanent versions.
  currentVersionNumber Int @default(0)

  // Admin-authored review outcome — only the *latest* reason for each kind, matching the
  // CampaignApplication/CreatorReferral convention (see DECISIONS.md ADR-012/013). The full,
  // never-deleted history of every review action lives in ContentReviewComment below.
  rejectionReason        String?
  changesRequestedReason String?

  submittedAt  DateTime?
  reviewedAt   DateTime?
  approvedAt   DateTime?
  rejectedAt   DateTime?
  expiredAt    DateTime?
  reviewedById String?
  reviewedBy   User?     @relation("ContentReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attachments ContentAttachment[]
  versions    ContentVersion[]
  comments    ContentReviewComment[]

  @@index([campaignId])
  @@index([creatorId])
  @@index([campaignApplicationId])
  @@index([status])
  @@index([createdAt])
  @@index([submittedAt])
  @@index([reviewedAt])
}

enum ContentAttachmentType {
  IMAGE
  VIDEO
}

// ATTACHMENT = general supporting image/video; THUMBNAIL = the single representative preview
// image (same "at most one" pattern as CampaignMedia's COVER — enforced by a partial unique
// index, ContentAttachment_thumbnail_unique, raw SQL since Prisma can't express partial indexes).
enum ContentAttachmentRole {
  ATTACHMENT
  THUMBNAIL
}

// Binary content lives behind the StoragePort abstraction (same local-disk adapter as
// CampaignMedia) — only keys/URLs/metadata are stored here, never raw bytes in Postgres.
model ContentAttachment {
  id               String                @id @default(cuid())
  contentId        String
  content          Content               @relation(fields: [contentId], references: [id], onDelete: Cascade)
  attachmentType   ContentAttachmentType
  role             ContentAttachmentRole
  storageKey       String
  publicUrl        String
  thumbnailUrl     String?
  originalFilename String
  mimeType         String
  fileSizeBytes    Int
  width            Int?
  height           Int?
  durationSeconds  Int?
  sortOrder        Int                   @default(0)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([contentId, sortOrder])
  @@index([contentId, role])
}

// Permanent, append-only snapshot of every submitted/resubmitted revision — never updated, never
// deleted (enforced by never exposing an update/delete path in ContentService, not a DB trigger).
// attachmentSnapshot freezes the attachment list (id/url/type/role) as it stood at that exact
// submission, independent of whatever attachments exist on the live Content row later.
model ContentVersion {
  id                 String   @id @default(cuid())
  contentId          String
  content            Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  versionNumber      Int
  caption            String?
  notes              String?
  hashtags           String[]
  metadata           Json?
  // Frozen at this exact submission, same reasoning as attachmentSnapshot below — the live
  // Content.postUrl can change on a later resubmit, but this version's own claim never should.
  postUrl            String?
  attachmentSnapshot Json
  submittedAt        DateTime @default(now())
  submittedById      String
  submittedBy        User     @relation("ContentVersionSubmittedBy", fields: [submittedById], references: [id])
  createdAt          DateTime @default(now())

  @@unique([contentId, versionNumber])
  @@index([contentId])
}

enum ContentReviewAction {
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

// Admin-authored, creator-read-only, never editable or deletable — the actual "Review Comments"
// + audit-adjacent history the spec requires, distinct from Content's own latest-reason fields
// (which only ever hold the most recent value for quick display).
model ContentReviewComment {
  id            String              @id @default(cuid())
  contentId     String
  content       Content             @relation(fields: [contentId], references: [id], onDelete: Cascade)
  // Denormalized, not a relation — the version being reviewed at comment time (same snapshot
  // convention as CampaignApplication.followerSnapshot).
  versionNumber Int
  authorId      String
  author        User                @relation("ContentReviewCommentAuthor", fields: [authorId], references: [id])
  action        ContentReviewAction
  comment       String
  createdAt     DateTime            @default(now())

  @@index([contentId, createdAt])
}

enum CreatorCampaignStatus {
  ACTIVE
  PAUSED
  ENDED
}

model CreatorCampaign {
  id         String                @id @default(cuid())
  campaignId String
  campaign   Campaign              @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creatorId  String
  creator    CreatorProfile        @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  status     CreatorCampaignStatus @default(ACTIVE)
  joinedAt   DateTime              @default(now())
  endedAt    DateTime?

  @@unique([campaignId, creatorId])
}

// ────────────────────────────────────────────────────────────────────────────
// Referral / Attribution / Promo
// ────────────────────────────────────────────────────────────────────────────

enum ReferralLinkStatus {
  ACTIVE
  PAUSED
  EXPIRED
}

model ReferralLink {
  id                    String             @id @default(cuid())
  code                  String             @unique // short slug e.g. "malika-serum"
  creatorId             String
  creator               CreatorProfile     @relation(fields: [creatorId], references: [id])
  campaignId            String
  campaign              Campaign           @relation(fields: [campaignId], references: [id])
  offerId               String
  offer                 Offer              @relation(fields: [offerId], references: [id])
  promoCodeId           String?            @unique
  promoCode             PromoCode?         @relation(fields: [promoCodeId], references: [id])
  status                ReferralLinkStatus @default(ACTIVE)
  startsAt              DateTime           @default(now())
  expiresAt             DateTime?
  attributionWindowDays Int                @default(30)
  createdAt             DateTime           @default(now())

  visits ReferralVisit[]

  // One referral link per creator per campaign — prevents the "generate link" action from
  // silently minting duplicates if called twice.
  @@unique([creatorId, campaignId])
  @@index([creatorId])
  @@index([campaignId])
}

model ReferralVisit {
  id             String        @id @default(cuid())
  referralLinkId String?
  referralLink   ReferralLink? @relation(fields: [referralLinkId], references: [id])
  creatorId      String?
  campaignId     String?
  campaign       Campaign?     @relation(fields: [campaignId], references: [id])
  offerId        String
  offer          Offer         @relation(fields: [offerId], references: [id])
  visitorId      String // server-issued, first-party — not solely a client cookie
  sessionId      String
  landingPage    String
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  ipHash         String
  userAgent      String?
  referrer       String?
  expiresAt      DateTime // createdAt + attributionWindowDays
  createdAt      DateTime      @default(now())

  // One visit can back more than one Attribution/Order (see Attribution.referralVisitId note).
  attributions Attribution[]

  @@index([offerId, createdAt])
  @@index([visitorId])
  @@index([creatorId])
  @@index([campaignId])
}

enum PromoDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

model PromoCode {
  id                 String            @id @default(cuid())
  // Always written/compared in canonical UPPERCASE by PromoCodesModule so the unique constraint
  // enforces the spec's "case-insensitive" rule without depending on a citext extension.
  code               String            @unique
  creatorId          String
  creator            CreatorProfile    @relation(fields: [creatorId], references: [id])
  campaignId         String
  campaign           Campaign          @relation(fields: [campaignId], references: [id])
  offerId            String
  offer              Offer             @relation(fields: [offerId], references: [id])
  discountType       PromoDiscountType
  discountValue      Int // percentage in basis points OR minor-unit amount
  minimumOrderAmount Int?
  usageLimit         Int?
  perCustomerLimit   Int?
  usageCount         Int               @default(0)
  startsAt           DateTime          @default(now())
  expiresAt          DateTime?
  isActive           Boolean           @default(true)
  createdAt          DateTime          @default(now())

  referralLink ReferralLink?
  usages       PromoCodeUsage[]
  orders       Order[]

  // One promo code per creator per campaign — mirrors the ReferralLink constraint above.
  @@unique([creatorId, campaignId])
  @@index([campaignId])
}

model PromoCodeUsage {
  id          String    @id @default(cuid())
  promoCodeId String
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  orderId     String    @unique
  order       Order     @relation(fields: [orderId], references: [id])
  customerId  String?
  createdAt   DateTime  @default(now())

  @@index([promoCodeId])
}

enum AttributionSource {
  PROMO_CODE
  REFERRAL_VISIT
  MANUAL
}

// One row per Order — the resolved, immutable record of which creator gets credit.
model Attribution {
  id              String            @id @default(cuid())
  orderId         String            @unique
  order           Order             @relation(fields: [orderId], references: [id])
  creatorId       String
  campaignId      String
  offerId         String
  source          AttributionSource
  // NOT unique: one ReferralVisit (one click) legitimately backs multiple Orders/Attributions
  // when a buyer returns and purchases more than once inside the attribution window. The
  // uniqueness guarantee that matters is Attribution.orderId above — one order, one attribution.
  referralVisitId String?
  referralVisit   ReferralVisit?    @relation(fields: [referralVisitId], references: [id])
  promoCodeId     String?
  isSelfReferral  Boolean           @default(false)
  fraudRiskFlags  String[]
  manualById      String? // admin userId, required if source == MANUAL
  manualReason    String?
  createdAt       DateTime          @default(now())

  @@index([creatorId])
  @@index([campaignId])
}

// ────────────────────────────────────────────────────────────────────────────
// Customer / Order
// ────────────────────────────────────────────────────────────────────────────

model Customer {
  id        String   @id @default(cuid())
  fullName  String
  phone     String
  email     String?
  createdAt DateTime @default(now())
  // Nullable, unique — links a Customer to a real Buyer account once one exists. A Customer row
  // is created at guest checkout regardless of whether the phone number ever becomes a real
  // account (see OrdersService.upsertCustomer); this stays null for true guests forever. Set at
  // buyer registration (phone-match reconciliation) or at checkout time when a logged-in buyer's
  // session is present — see DECISIONS.md's Buyer Accounts ADR for the exact merge rule.
  // onDelete: SetNull, not Cascade — a Customer's order history is a financial/business record
  // that must survive even if the linked User account is later deleted, unlike SavedProduct/
  // BuyerAddress below which are pure convenience data with no reason to outlive the account.
  userId    String?  @unique
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  addresses Address[]
  orders    Order[]

  @@index([phone])
}

// Buyer's own "wishlist" — deliberately keyed on User.id directly (no separate BuyerProfile
// model exists or is needed: unlike Creator, every authenticated User can act as a buyer with no
// approval gate, so there is nothing a distinct profile row would add here).
model SavedProduct {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  offerId   String
  offer     Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, offerId])
  @@index([userId])
}

// A buyer's saved addresses for faster repeat checkout — deliberately separate from the
// checkout-time `Address` model above, which is an immutable per-order snapshot. A saved address
// is copied into a fresh `Address` row at checkout time, never reused by reference, so editing or
// deleting a saved address can never retroactively change what a past order shipped to.
model BuyerAddress {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String?
  region    String
  city      String
  district  String?
  line1     String
  comment   String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Address {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  region     String
  city       String
  district   String?
  line1      String
  comment    String?

  orders Order[]
}

enum OrderType {
  PHYSICAL
  DIGITAL
  COURSE
  SERVICE
  LEAD
}

// Replaces the Phase 1 draft's NEW/CONFIRMED/COMPLETED/RETURNED with the Phase 8 spec's explicit
// checkout-lifecycle state set (see DECISIONS.md ADR-015). No real Order rows existed yet (no
// backend slice had been built — OrdersService didn't exist before this phase), so this is a
// clean rename, not a destructive change to real data. CREATED/PAYMENT_PENDING are new states that
// let an Order exist before payment resolves; PROCESSING/SHIPPED reuse the same names fulfillment
// already understood; IN_TRANSIT is new (distinct from SHIPPED — "picked up" vs "en route").
enum OrderStatus {
  CREATED
  PAYMENT_PENDING
  PAID
  PROCESSING
  SHIPPED
  IN_TRANSIT
  DELIVERED
  CANCELLED
  REFUNDED
}

model Order {
  id             String      @id @default(cuid())
  publicToken    String      @unique @default(cuid())
  idempotencyKey String      @unique
  type           OrderType
  offerId        String
  offer          Offer       @relation(fields: [offerId], references: [id])
  campaignId     String?
  campaign       Campaign?   @relation(fields: [campaignId], references: [id])
  customerId     String
  customer       Customer    @relation(fields: [customerId], references: [id])
  addressId      String?
  address        Address?    @relation(fields: [addressId], references: [id])
  promoCodeId    String?
  promoCode      PromoCode?  @relation(fields: [promoCodeId], references: [id])
  status         OrderStatus @default(CREATED)
  offerSnapshot  Json // frozen offer/variant content at purchase time
  subtotalMinor  Int
  discountMinor  Int         @default(0)
  shippingMinor  Int         @default(0)
  totalMinor     Int
  currency       String      @default("UZS")
  // Buyer-facing choice captured at checkout ("courier"/"pickup"/"cargo"/"cod") — free-text, same
  // convention as Shipment.method. Copied into Shipment.method when fulfillment creates that row;
  // kept here too since a Shipment may not exist yet at every point in the Order's early lifecycle.
  deliveryMethod String?
  notes          String? // buyer's checkout notes ("Customer Information: Notes" in the spec)
  fraudRiskFlags String[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  items          OrderItem[]
  statusHistory  OrderStatusHistory[]
  payment        Payment?
  shipment       Shipment?
  attribution    Attribution?
  commission     Commission?
  refunds        Refund[]
  promoCodeUsage PromoCodeUsage?

  @@index([status])
  @@index([offerId])
  @@index([customerId])
  @@index([campaignId])
  // Phase 13 (Analytics) — every analytics KPI is a date-range query; this was the single
  // biggest gap ANALYTICS.md's design flagged (Finding #1). A plain column index lets Postgres
  // bitmap-scan it together with the existing status/offerId/campaignId indexes rather than
  // needing a combinatorial set of composite indexes for every filter combination.
  @@index([createdAt])
}

model OrderItem {
  id             String        @id @default(cuid())
  orderId        String
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId      String?
  variant        OfferVariant? @relation(fields: [variantId], references: [id])
  nameSnapshot   String
  quantity       Int           @default(1)
  unitPriceMinor Int
  totalMinor     Int

  @@index([orderId])
}

model OrderStatusHistory {
  id          String       @id @default(cuid())
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  changedById String?
  note        String?
  createdAt   DateTime     @default(now())

  @@index([orderId])
}

// ────────────────────────────────────────────────────────────────────────────
// Payment / Shipping
// ────────────────────────────────────────────────────────────────────────────

enum PaymentProviderType {
  CLICK
  PAYME
  UZUM_NASIYA
  CARD
  CASH_ON_DELIVERY
  MANUAL
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

model Payment {
  id                String              @id @default(cuid())
  orderId           String              @unique
  order             Order               @relation(fields: [orderId], references: [id])
  provider          PaymentProviderType
  status            PaymentStatus       @default(PENDING)
  amountMinor       Int
  currency          String              @default("UZS")
  providerReference String?
  merchantReference String              @unique
  webhookPayloads   Json[]
  idempotencyKey    String              @unique
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([status])
  @@index([providerReference])
  @@index([merchantReference])
  // Phase 13 (Analytics) — see Order.createdAt's index comment above; Payment Analytics'
  // method/success-rate breakdowns are date-range queries against this table directly.
  @@index([createdAt])
}

enum ShipmentStatus {
  PENDING
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  FAILED
}

model Shipment {
  id             String         @id @default(cuid())
  orderId        String         @unique
  order          Order          @relation(fields: [orderId], references: [id])
  method         String // courier | region_delivery | pickup | cargo | cod
  trackingNumber String?
  costMinor      Int            @default(0)
  status         ShipmentStatus @default(PENDING)
  shippedAt      DateTime?
  deliveredAt    DateTime?

  @@index([status])
}

// ────────────────────────────────────────────────────────────────────────────
// Commission / Refund / Payout
// ────────────────────────────────────────────────────────────────────────────

// Snapshot of the rule in effect for a Campaign at the moment an order is placed.
// Orders reference the snapshot, never the live Campaign row, for commission math.
// Field names/shape (Phase 8) now mirror Campaign.commissionType/commissionRateBps/
// commissionAmountMinor exactly — this model predates the 6B Enhancement rename that narrowed
// Campaign's commission fields and had zero real rows, so realigning it here (rather than keeping
// the old commissionValue/fixedPaymentMinor dual-meaning pair) is a rename, not a breaking change.
// See DECISIONS.md ADR-015.
model CommissionRule {
  id                    String         @id @default(cuid())
  campaignId            String
  campaign              Campaign       @relation(fields: [campaignId], references: [id])
  commissionType        CommissionType
  // Same mutual-exclusivity convention as Campaign: PERCENTAGE => commissionRateBps set,
  // FIXED_AMOUNT => commissionAmountMinor set.
  commissionRateBps     Int?
  commissionAmountMinor Int?
  effectiveFrom         DateTime       @default(now())
  effectiveTo           DateTime?

  commissions Commission[]

  @@index([campaignId])
}

enum CommissionStatus {
  PENDING
  APPROVED
  REJECTED
  REFUNDED
  PAYABLE
  PAID
  // Phase N (Creator Fund) — a PAYABLE commission the creator voluntarily contributed to the
  // shared Creator Fund instead of withdrawing. Kept distinct from PAID so wallet balance
  // breakdowns never conflate "paid out to me" with "donated away" — see DECISIONS.md ADR-032.
  DONATED
}

model Commission {
  id                 String                   @id @default(cuid())
  orderId            String                   @unique
  order              Order                    @relation(fields: [orderId], references: [id])
  creatorId          String
  creator            CreatorProfile           @relation(fields: [creatorId], references: [id])
  commissionRuleId   String
  commissionRule     CommissionRule           @relation(fields: [commissionRuleId], references: [id])
  baseAmountMinor    Int // order subtotal after discount, before shipping/tax/fees
  amountMinor        Int
  currency           String                   @default("UZS")
  status             CommissionStatus         @default(PENDING)
  approvedAt         DateTime?
  payableAt          DateTime?
  paidAt             DateTime?
  payoutId           String?
  payout             Payout?                  @relation(fields: [payoutId], references: [id])
  // Phase N (Creator Fund) — mirrors payoutId's lock-then-settle shape exactly, but for a
  // contribution instead of a withdrawal. A commission is locked by exactly one of
  // payoutId/fundContributionId at a time, never both.
  donatedAt          DateTime?
  fundContributionId String?
  fundContribution   CreatorFundContribution? @relation(fields: [fundContributionId], references: [id])
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  ledgerEntries CommissionLedger[]

  @@index([creatorId, status])
  // Phase 13 (Analytics) — see Order.createdAt's index comment above; Creator Analytics'
  // earnings time-series buckets by this column (Commission.createdAt ≈ Order.createdAt, set in
  // the same checkout transaction — see DECISIONS.md ADR-020).
  @@index([createdAt])
  // Launch-readiness fix — [creatorId, status] above can't serve NotificationSweepService's
  // global (non-creator-scoped) status sweep at all; this can, and also bounds it by recency.
  @@index([status, updatedAt])
}

enum LedgerEntryType {
  ACCRUAL
  REVERSAL
  PAYOUT
  // Phase N (Creator Fund) — mirrors PAYOUT's "money left the available balance" meaning, distinct
  // destination only.
  DONATION
}

// Append-only ledger — Commission.status is a derived read model, this table is
// the source of truth for "why does this creator's balance say what it says".
model CommissionLedger {
  id           String          @id @default(cuid())
  commissionId String
  commission   Commission      @relation(fields: [commissionId], references: [id], onDelete: Cascade)
  type         LedgerEntryType
  amountMinor  Int // signed: positive for ACCRUAL, negative for REVERSAL/PAYOUT
  reason       String?
  createdAt    DateTime        @default(now())

  @@index([commissionId])
}

enum RefundStatus {
  REQUESTED
  APPROVED
  PROCESSED
  REJECTED
}

model Refund {
  id              String       @id @default(cuid())
  orderId         String
  order           Order        @relation(fields: [orderId], references: [id])
  amountMinor     Int
  reason          String
  status          RefundStatus @default(REQUESTED)
  requestedById   String?
  // Phase 12 (Admin Operations) — the administrative approve/reject decision on this Refund row,
  // distinct from `processedAt` (when PROCESSED happens — still dormant, no code sets it, same as
  // before this phase) and from the order-level financial action `OrdersService.createRefund`
  // already performs synchronously at request time for full refunds (stock release + Order status
  // -> REFUNDED). Approve/reject here is a review decision layered on top of the pre-existing
  // Refund row, never a trigger for a second money-movement — see DECISIONS.md ADR-019.
  reviewedById    String?
  reviewedAt      DateTime?
  rejectionReason String?
  processedAt     DateTime?
  createdAt       DateTime     @default(now())

  @@index([orderId])
  @@index([status])
  // Phase 13 (Analytics) — see Order.createdAt's index comment above; Refund Analytics' rate/
  // reasons/average-amount breakdowns are date-range queries against this table directly.
  @@index([createdAt])
}

enum PayoutMethodType {
  CARD
  BANK_ACCOUNT
}

model PayoutMethod {
  id            String           @id @default(cuid())
  creatorId     String
  creator       CreatorProfile   @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  type          PayoutMethodType
  cardNumberEnc String? // encrypted at rest, masked on read
  cardHolder    String?
  bankName      String?
  bankAccount   String?
  isDefault     Boolean          @default(false)
  // Soft-delete: a creator "removing" a payout method must never hard-delete this row, since
  // historical Payout rows reference it by required FK. Deactivation only.
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())

  payouts Payout[]

  @@index([creatorId])
}

// Replaces the Phase 1 draft's UNDER_REVIEW-inclusive set with the Phase 9 spec's explicit
// withdrawal-workflow states. Zero real Payout rows existed before this phase (no PayoutsService
// existed), so this is a rename/narrowing, not a breaking change — same reasoning as ADR-015's
// OrderStatus replacement. CANCELLED (creator withdraws the request while still REQUESTED) and
// FAILED (admin marks a PROCESSING transfer as having bounced — no automatic bank integration, so
// this is always a manual admin signal) are new; UNDER_REVIEW is dropped since REQUESTED already
// covers "awaiting admin decision" and the spec's own list doesn't include it. See DECISIONS.md
// ADR-016.
enum PayoutStatus {
  REQUESTED
  APPROVED
  PROCESSING
  PAID
  REJECTED
  CANCELLED
  FAILED
}

model Payout {
  id              String         @id @default(cuid())
  creatorId       String
  creator         CreatorProfile @relation(fields: [creatorId], references: [id])
  payoutMethodId  String
  payoutMethod    PayoutMethod   @relation(fields: [payoutMethodId], references: [id])
  amountMinor     Int
  currency        String         @default("UZS")
  status          PayoutStatus   @default(REQUESTED)
  requestedAt     DateTime       @default(now())
  reviewedById    String?
  reviewedAt      DateTime?
  paidAt          DateTime?
  rejectionReason String?
  // Launch-readiness fix — every sibling money-movement model (Order/Payment/Commission) already
  // had this; Payout didn't, which is what let NotificationSweepService's status-only query grow
  // unbounded forever (nothing to time-bound it by). See DECISIONS.md's launch-readiness ADR.
  updatedAt       DateTime       @updatedAt

  commissions Commission[]

  @@index([creatorId, status])
  // Serves NotificationSweepService's global (non-creator-scoped) status sweep and
  // ActivityTickerService's `status: "PAID", paidAt: {...}` query — [creatorId, status] above is
  // useless for either since neither filters by creatorId.
  @@index([status, updatedAt])
}

// Phase N (Creator Motivation System — Creator Fund). Unlike Payout, a contribution never leaves
// the platform and needs no admin review/processing delay — it's an internal transfer from one
// creator's available balance into a shared pool, so it settles synchronously in the same request
// that creates it (see CreatorFundService.contribute — locks PAYABLE commissions the same
// race-safe way PayoutsService.requestPayout does, then immediately marks them DONATED instead of
// leaving them locked pending a later settlement step). `message` is an optional public shout-out
// shown next to the contribution on the fund's contributor leaderboard.
model CreatorFundContribution {
  id          String         @id @default(cuid())
  creatorId   String
  creator     CreatorProfile @relation(fields: [creatorId], references: [id])
  amountMinor Int
  currency    String         @default("UZS")
  message     String?
  createdAt   DateTime       @default(now())

  commissions Commission[]

  @@index([creatorId])
  @@index([createdAt])
}

// ────────────────────────────────────────────────────────────────────────────
// Cross-cutting: notifications, audit, settings, files
// ────────────────────────────────────────────────────────────────────────────

enum NotificationChannel {
  IN_APP
  TELEGRAM
  EMAIL
}

// Delivery state for the TELEGRAM/EMAIL channels — an IN_APP row is always created directly as
// SENT (there is no real "delivery" step, it's just a database row the creator/admin reads later).
// See DECISIONS.md ADR-017.
enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
}

model Notification {
  id            String                     @id @default(cuid())
  userId        String
  user          User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel       NotificationChannel
  type          String // "campaign_application.submitted", "order.received", "payout.paid", ...
  payload       Json
  readAt        DateTime?
  status        NotificationDeliveryStatus @default(PENDING)
  attempts      Int                        @default(0)
  lastAttemptAt DateTime?
  error         String?
  // Deterministic idempotency key (e.g. "payout.failed:cmrx1eih8...") — lets the Phase 8/9 sweep
  // (see NotificationSweepService, ADR-017) safely rescan every interval via
  // `createMany({ skipDuplicates: true })` without ever double-notifying for the same business
  // event, with no dependency on any timestamp/cursor state.
  dedupKey      String?                    @unique
  createdAt     DateTime                   @default(now())

  @@index([userId, readAt])
  @@index([channel, status])
}

// One row per (user, category) that the user has explicitly touched — an absent row means "use
// the default" (see NotificationsService), so existing users never need a backfill migration.
enum NotificationCategory {
  CAMPAIGN_APPLICATION
  ORDER
  COMMISSION
  PAYOUT
  ACCOUNT
  ADMIN_ALERTS
}

model NotificationPreference {
  id        String               @id @default(cuid())
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  NotificationCategory
  inApp     Boolean              @default(true)
  telegram  Boolean              @default(false)
  email     Boolean              @default(true)
  updatedAt DateTime             @updatedAt

  @@unique([userId, category])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id])
  action     String // "order.status_changed", "attribution.manual_override", ...
  entityType String
  entityId   String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ---- Creator-to-creator referral program (6B Enhancement) ----
//
// Distinct from ReferralLink/ReferralVisit above, which are the creator→CUSTOMER sales-attribution
// concept. This block is creator→CREATOR recruiting: one immutable direct referrer per creator,
// direct referrals only (no multilevel/MLM — Creator A never earns from creators invited by
// Creator B). Rewards require real productive activity, never registration alone; nothing here is
// marked PAID until the future Payout ledger exists. See DECISIONS.md ADR-013.

model CreatorReferral {
  id                String         @id @default(cuid())
  referrerCreatorId String
  referrer          CreatorProfile @relation("ReferralReferrer", fields: [referrerCreatorId], references: [id], onDelete: Cascade)
  // Unique: a creator has at most ONE direct referrer, ever (duplicate attribution is a DB-level
  // impossibility, not just a service check).
  referredCreatorId String         @unique
  referred          CreatorProfile @relation("ReferralReferred", fields: [referredCreatorId], references: [id], onDelete: Cascade)
  referralCodeUsed  String
  attributedAt      DateTime       @default(now())
  registeredAt      DateTime

  // Milestone timestamps — filled in as the referred creator's real activity happens. The
  // Content/sale/earning ones stay NULL until those future domains exist and emit the
  // corresponding integration events (see ReferralEventsService).
  onboardingCompletedAt              DateTime?
  creatorApprovedAt                  DateTime?
  firstCampaignApplicationAt         DateTime?
  firstApprovedCampaignApplicationAt DateTime?
  firstApprovedContentAt             DateTime?
  firstQualifiedSaleAt               DateTime?
  firstQualifiedEarningAt            DateTime?

  qualifiedAt            DateTime?
  disqualifiedAt         DateTime?
  disqualificationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rewards CreatorReferralReward[]

  @@index([referrerCreatorId, createdAt])
}

enum ReferralRewardType {
  MILESTONE_FIXED
  EARNINGS_PERCENTAGE
}

enum ReferralMilestoneType {
  FIRST_APPROVED_CAMPAIGN_APPLICATION
  FIRST_APPROVED_CONTENT
  FIRST_QUALIFIED_SALE
  FIRST_APPROVED_COMMISSION
  MIN_CUMULATIVE_EARNINGS
}

// Configurable reward programs — not one hard-coded rule. MILESTONE_FIXED pays fixedRewardMinor
// once when the referred creator reaches milestoneType; EARNINGS_PERCENTAGE accrues
// rewardRateBps of qualified approved earnings inside earningWindowDays (dormant until the
// Order/Commission domains emit real earning events). Registration alone is deliberately NOT a
// representable milestone.
model CreatorReferralRule {
  id                               String                 @id @default(cuid())
  name                             String
  rewardType                       ReferralRewardType
  milestoneType                    ReferralMilestoneType?
  fixedRewardMinor                 Int?
  rewardRateBps                    Int?
  currency                         String                 @default("UZS")
  qualifyingEarningsThresholdMinor Int?
  earningWindowDays                Int?
  maximumRewardPerReferralMinor    Int?
  startsAt                         DateTime?
  endsAt                           DateTime?
  active                           Boolean                @default(true)
  createdAt                        DateTime               @default(now())
  updatedAt                        DateTime               @updatedAt

  rewards CreatorReferralReward[]

  @@index([active, startsAt, endsAt])
}

// PAID exists in the enum for forward-compatibility but nothing sets it yet — there is no payout
// ledger. Marking a reward PAID before Payout exists would be a false financial claim.
enum ReferralRewardStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

model CreatorReferralReward {
  id         String               @id @default(cuid())
  referralId String
  referral   CreatorReferral      @relation(fields: [referralId], references: [id], onDelete: Cascade)
  ruleId     String
  rule       CreatorReferralRule  @relation(fields: [ruleId], references: [id])
  status     ReferralRewardStatus @default(PENDING)

  // Idempotency anchor: which real domain event produced this reward. Re-processing the same
  // event (retries, replays) hits the unique constraint below instead of double-paying.
  sourceType String
  sourceId   String

  qualifiedEarningsMinor Int?
  calculatedRewardMinor  Int
  currency               String    @default("UZS")
  approvedAt             DateTime?
  rejectedAt             DateTime?
  rejectionReason        String?
  paidAt                 DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@unique([referralId, ruleId, sourceType, sourceId])
  @@index([status])
}
