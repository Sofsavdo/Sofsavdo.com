# Copy to .env and fill in real values locally. Never commit the real .env.

# --- Database / cache ---
DATABASE_URL=postgresql://rosti:rosti@localhost:5432/rosti
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- App URLs ---
WEB_APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# --- Object storage (S3-compatible / Cloudflare R2) ---
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# --- Payment providers (MockProvider used until these are supplied) ---
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
UZUM_NASIYA_MERCHANT_ID=
UZUM_NASIYA_SECRET_KEY=

# --- Telegram bot (notifications only, optional) ---
TELEGRAM_BOT_TOKEN=

# --- Monitoring / analytics ---
SENTRY_DSN=
POSTHOG_API_KEY=
POSTHOG_HOST=

NODE_ENV=development
