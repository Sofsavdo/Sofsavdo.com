# Copy to .env and fill in real values locally. Never commit the real .env.
#
# Phase 14 (Production Hardening): apps/api/src/config/env-validation.ts enforces a hard,
# aggregated startup failure when NODE_ENV=production and any of the following are missing, empty,
# or still set to a known development placeholder: DATABASE_URL, JWT_ACCESS_SECRET,
# JWT_REFRESH_SECRET, PAYOUT_ENCRYPTION_KEY, WEB_APP_URL, API_URL, CLICK_MERCHANT_ID,
# CLICK_SERVICE_ID, CLICK_SECRET_KEY, CLICK_ENV. See ENVIRONMENT.md for the full required/optional
# list with explanations. Everything else below is optional — the app degrades (never crashes) if
# it's absent; each section below says exactly what "absent" means for that feature.

# --- Database / cache ---
DATABASE_URL=postgresql://sofsavdo:sofsavdo@localhost:5432/sofsavdo
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
AUTH_MAX_FAILED_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_DURATION_MINUTES=15

# --- App URLs ---
WEB_APP_URL=https://sofsavdo.com
API_URL=https://api.sofsavdo.com

# --- Frontend API mode (apps/web) ---
# "mock" = apps/web/src/mocks/store.ts, no backend needed — a fully offline demo mode.
# "real" (default, production) = the real NestJS API. As of this commit every domain is real-backed (see
# PROJECT_STATUS.md's Phase M pre-launch audit); production must always use "real".
NEXT_PUBLIC_API_MODE=real
NEXT_PUBLIC_API_URL=https://api.sofsavdo.com

# --- Object storage (S3-compatible / Cloudflare R2) ---
# "local" (dev/test only — files land on this machine's disk) or "s3" (real S3/R2/GCS,
# using the fields below — every field below only matters when this is "s3").
STORAGE_DRIVER=s3
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# R2/MinIO need path-style requests (bucket.region.amazonaws.com won't resolve for them) — leave
# false for real AWS S3.
STORAGE_FORCE_PATH_STYLE=false
# Overrides the URL stored/served objects are reachable at (a CDN/custom domain in front of the
# bucket, most commonly) — omit to use the provider's own endpoint.
STORAGE_PUBLIC_BASE_URL=

# --- Payment providers (dev-fallback secret used until these are supplied) ---
# CLICK_ENV declares which credential set the three fields below actually are — "test" or
# "production". In a NODE_ENV=production deploy this must be "production"; the app refuses to
# start otherwise (see apps/api/src/config/env-validation.ts). This exists specifically so a real
# launch can never run against Click's test merchant by a copy-paste mistake, or vice versa.
CLICK_ENV=production
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
# Payme/Uzum Nasiya are not integrated — see DECISIONS.md; these keys are reserved for a future
# phase and read by nothing today.
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
UZUM_NASIYA_MERCHANT_ID=
UZUM_NASIYA_SECRET_KEY=

# --- Wallet / Payout (Phase 9) ---
PAYOUT_MINIMUM_MINOR=10000000
PAYOUT_ENCRYPTION_KEY=

# --- Production admin bootstrap (Phase 14) — only used by `npm run bootstrap:admin`, never read
# by the running app itself. Set these two on the command line for that one invocation (see
# RUNBOOK.md), not in a committed .env file — there is no reason for this password to live
# anywhere after the first login, since it should be rotated immediately.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# --- Notifications (Phase 10) — Telegram/Email delivery; leaving these empty is safe, delivery
# simply fails loudly per-send (captured as a FAILED Notification row) rather than pretending to
# succeed. TELEGRAM_BOT_TOKEN was reserved since Phase 1; now actually consumed by TelegramBotAdapter. ---
TELEGRAM_BOT_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@sofsavdo.com
NOTIFICATION_MAX_DELIVERY_ATTEMPTS=3

# --- Monitoring / analytics ---
# ERROR_REPORTING_WEBHOOK_URL is the Phase 14 external error-reporting hook that's actually read
# (see apps/api/src/common/error-reporting/): every 5xx AllExceptionsFilter catches is still logged
# locally either way; setting this additionally POSTs a JSON payload (message, truncated stack,
# requestId, statusCode, code, method, path, userId) to the URL — point it at a real provider's
# webhook ingest endpoint, an internal alerting service, or a Slack incoming webhook. Absent by
# default and never required for startup or normal operation.
ERROR_REPORTING_WEBHOOK_URL=
# SENTRY_DSN/POSTHOG_* are reserved for a future phase and read by nothing today — same
# "reserved-but-unread" convention as the Payme/Uzum Nasiya keys above.
SENTRY_DSN=
POSTHOG_API_KEY=
POSTHOG_HOST=

NODE_ENV=production
